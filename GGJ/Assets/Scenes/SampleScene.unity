  dialogueManager: {fileID: 2129468912}
  dialoguePanel: {fileID: 2022224784}
--- !u!114 &1311858677
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1311858673}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07f4c7bb8ba526946812cf41a4598d2e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  dialoguePanel: {fileID: 2022224784}
  dialogueText: {fileID: 1008782293}
  speakerText: {fileID: 1494510661}
  playerName: Oyuncu
  characterName: Elif
  dialogueManager: {fileID: 2129468912}
  dialogueLines:
  - ' Merhaba.'
  - " Merhaba\u2026\n Bu kadar insan\u0131n aras\u0131nda biriyle g\xF6z g\xF6ze
    gelmek garip hissettiriyor, de\u011Fil mi?"
  - " Maskeler y\xFCz\xFCnden mi?"
  - " Evet.\n Kim oldu\u011Fumuzu sakl\u0131yoruz ama sanki daha rahat konu\u015Fuyoruz.\n
    Normalde s\xF6yleyemeyece\u011Fimiz \u015Feyleri s\xF6yl\xFCyoruz."
  - " Bu baloya ilk geli\u015Fin mi?"
  - " Evet.\n Asl\u0131nda daveti al\u0131nca \xE7ok heyecanland\u0131m.\n Sonra\u2026
    Arif'in de gelece\u011Fini \xF6\u011Frendim."
  - ' Arif Naim.'
  - " Evet.\n Onu y\u0131llarca okudum.\n Bir c\xFCmlesi y\xFCz\xFCnden yazmaya ba\u015Flad\u0131m
    desem abartm\u0131\u015F olmam."
  - " Peki\u2026 tan\u0131\u015F\u0131nca ne oldu?"
  - " ( k\u0131sa bir duraksama )\n Kitab\u0131m\u0131 okudu\u011Funu s\xF6yledi.\n
    Sonra da \u201Cham ama cesur\u201D dedi.\n O g\xFCn \xE7ok sevinmi\u015Ftim.\n
    Bir hafta sonra yazd\u0131\u011F\u0131 ele\u015Ftiriyi okuyunca\u2026\n ayn\u0131
    kitab\u0131 yazan ben miydim emin olamad\u0131m."
  - " Bu gece konu\u015Ftunuz mu?"
  - " Hay\u0131r.\n Asl\u0131nda konu\u015Fmak istedim.\n Ama o\u2026 kalabal\u0131ktan
    ka\xE7\u0131yordu.\n K\xFCt\xFCphaneye do\u011Fru gitti\u011Fini g\xF6rd\xFCm."
  - " Yaln\u0131z m\u0131yd\u0131?"
  - " Evet.\n Ya da yaln\u0131z g\xF6r\xFCn\xFCyordu diyelim.\n Bu baloda kim ger\xE7ekten
    yaln\u0131z ki?"
  - ' Sinirli miydi sence?'
  - " Hay\u0131r\u2026\n Daha \xE7ok yorgun gibiydi.\n Sanki bir \u015Fey yazm\u0131\u015F
    da art\u0131k kimsenin okumas\u0131n\u0131 istemiyormu\u015F gibi."
  - " Bu seni \u015Fa\u015F\u0131rtt\u0131 m\u0131?"
  - " Biraz.\n \xC7\xFCnk\xFC Arif hep konu\u015Furdu.\n Ger\xE7eklerden, cesaretten,
    d\xFCr\xFCstl\xFCkten.\n Ama bu gece\u2026 susmay\u0131 se\xE7mi\u015F gibiydi."
  - " ( omuz silker )\n Belki de baz\u0131 hik\xE2yeler\u2026\n yaz\u0131ld\u0131ktan
    sonra bile insan\u0131 rahat b\u0131rakmaz."
  - " Anlad\u0131m."
  - " Yine de burada olmak g\xFCzel.\n Ne olursa olsun, yazarl\u0131k b\xF6yle gecelerle
    anlam kazan\u0131yor san\u0131r\u0131m."
  - " Hakl\u0131s\u0131n.\n O zaman\u2026 iyi e\u011Flenceler."
  - " Sana da.\n Umar\u0131m bu gece herkes maskesini \xE7\u0131karmak zorunda kalmaz."
  characterID: 1
